<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BoxPlanLib.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoxPlanLib\BoxPlanLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\BoxPlanLib\sample-plans\**\*.yml"
             Link="sample-plans\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
